---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import CompanyLogo from '../../components/ui/CompanyLogo.astro';
import OfferCard from '../../components/ui/OfferCard.astro';
import Steps from '../../components/ui/Steps.astro';
import Icon from '../../components/Icon.astro';
import ProductConditions from '../../components/ProductConditions.astro';
import { publishedOffers } from '../../data/products';
import { companyById } from '../../data/companies';
import { categoryById } from '../../data/categories';
import { purchaseLabels, obligationTone, type ObligationStatus } from '../../data/types';
import { site } from '../../data/site';
import { externalHost } from '../../lib/external-link';

export function getStaticPaths() {
  return publishedOffers.map((offer) => ({ params: { slug: offer.slug }, props: { offer } }));
}

const { offer } = Astro.props;
const company = companyById(offer.companyId);
const category = categoryById(offer.categoryId);
if (!company || !category) throw new Error(`Некорректные связи продукта ${offer.slug}`);

const basePath = offer.audience === 'individual' ? '/dlya-sebya' : '/dlya-biznesa';
const absoluteUrl = (path: string) => new URL(path, site.url).href;
const audienceLabel = offer.audience === 'individual' ? 'Для себя' : 'Для бизнеса';
const host = externalHost(offer.purchase.url);
const sourceHost = externalHost(offer.source.url);
const dateLabel = new Date(offer.checkedAt).toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

/* Обязательность берётся у предложения: внутри одной категории
   встречаются и обязательные, и добровольные продукты. */
const { obligation } = offer;

const obligationIcon: Record<ObligationStatus, 'warning' | 'success' | 'info'> = {
  required: 'warning',
  voluntary: 'success',
  conditional: 'info',
};

const related = publishedOffers
  .filter((o) => o.categoryId === offer.categoryId && o.audience === offer.audience && o.slug !== offer.slug)
  .slice(0, 3);

const stepsByMethod = {
  online: [
    { title: 'Откройте страницу продукта', text: `Кнопка ведёт на ${host}. Проверьте, что выбраны нужная программа и страхователь.` },
    { title: 'Заполните данные', text: 'Данные для расчёта и договора вводятся на странице оформления.' },
    { title: 'Проверьте условия и оформите', text: 'Перед оплатой проверьте покрытие, исключения и срок действия полиса.' },
  ],
  request: [
    { title: 'Откройте страницу страховщика', text: `Кнопка ведёт на ${host}, где можно отправить запрос или оставить заявку.` },
    { title: 'Уточните параметры и документы', text: 'Представитель страховщика сообщит, какие сведения нужны для расчёта.' },
    { title: 'Сравните предложение перед оформлением', text: 'Проверьте цену, покрытие и исключения в расчёте и проекте договора.' },
  ],
  office: [
    { title: 'Свяжитесь с отделением', text: `Уточните у страховщика адрес, график и возможность оформить продукт в ${host}.` },
    { title: 'Подготовьте документы', text: 'Список документов и требования к ним заранее подтвердите у страховщика.' },
    { title: 'Проверьте договор в отделении', text: 'До подписания сверьте условия, срок действия и итоговую стоимость.' },
  ],
  partner: [
    { title: 'Перейдите на сайт-партнёр', text: `Оформление открывается на ${host}; это партнёрская площадка, а не сайт страховщика.` },
    { title: 'Проверьте данные и условия', text: 'Уточните, какой страховщик указан в полисе, и прочитайте условия до оплаты.' },
    { title: 'Завершите оформление на площадке', text: 'Порядок оплаты и получения полиса зависит от правил сайта-партнёра.' },
  ],
} satisfies Record<typeof offer.purchase.method, { title: string; text: string }[]>;

const steps = stepsByMethod[offer.purchase.method];
const destinationLabel = offer.purchase.method === 'partner'
  ? 'Оформление открывается на партнёрском сайте:'
  : offer.purchase.method === 'office'
    ? 'Информация об оформлении у страховщика:'
    : 'Страница оформления у страховщика:';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: audienceLabel, item: absoluteUrl(`${basePath}/`) },
      { '@type': 'ListItem', position: 3, name: category.navTitle, item: absoluteUrl(`${basePath}/${category.slug}/`) },
      { '@type': 'ListItem', position: 4, name: offer.title, item: absoluteUrl(`/predlozhenie/${offer.slug}/`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${offer.title} — ${company.name}`,
    url: absoluteUrl(`/predlozhenie/${offer.slug}/`),
    description: offer.tagline,
    inLanguage: 'ru-KZ',
    ...(offer.editorial?.contentModifiedAt ? { dateModified: offer.editorial.contentModifiedAt } : {}),
    isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
  },
];
---

<Base
  title={`${offer.title} — ${company.name}`}
  description={`${offer.tagline} Покрытие, ограничения, способ оформления и официальная ссылка. Проверено ${dateLabel}.`}
  audience={offer.audience}
  schema={schema}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: 'Главная', href: '/' },
        { label: audienceLabel, href: `${basePath}/` },
        { label: category.navTitle, href: `${basePath}/${category.slug}/` },
        { label: offer.title },
      ]}
    />

    <header class="offer-header">
      <div class="offer-header__company">
        <a class="offer-header__brand" href={`/kompanii/${company.slug}/`}>
          <CompanyLogo company={company} variant="compact" />
          <span>{company.name}</span>
        </a>
        <span class="chip chip--outline">{audienceLabel}</span>
        <a class="chip" href={`${basePath}/${category.slug}/`}>{category.navTitle}</a>
      </div>
      <h1>{offer.title}</h1>
      <p class="offer-header__tagline">{offer.tagline}</p>
      <div class="meta-row" style="margin-top:14px">
        <span class="chip chip--brand">{purchaseLabels[offer.purchase.method]}</span>
        <Badge tone={obligationTone[obligation.status]} icon={obligationIcon[obligation.status]}>
          {obligation.label}
        </Badge>
        <span class="chip chip--outline">Проверено {dateLabel}</span>
      </div>
    </header>

    <section class="offer-summary" aria-labelledby="offer-summary-title">
      <div class="offer-summary__top">
        <div>
          <span class="eyebrow">Кратко о предложении</span>
          <h2 id="offer-summary-title">Основные условия</h2>
        </div>
        <span class="chip chip--outline">Источник проверен {dateLabel}</span>
      </div>
      <dl class="offer-summary__facts">
        <div>
          <dt>Покрытие</dt>
          <dd>{offer.coverage.slice(0, 2).join(' · ')}</dd>
        </div>
        <div>
          <dt>Стоимость</dt>
          <dd>{offer.price.text}</dd>
        </div>
        <div>
          <dt>Обязательность</dt>
          <dd>{obligation.label}</dd>
        </div>
        <div>
          <dt>Оформление</dt>
          <dd>{purchaseLabels[offer.purchase.method]}</dd>
        </div>
      </dl>
      <nav class="offer-summary__nav" aria-label="Перейти к подробным условиям">
        <a href="#coverage-title">Покрытие</a>
        {offer.conditions && <a href="#structured-conditions-title">Ключевые параметры</a>}
        <a href="#limits-title">Лимиты и условия</a>
        <a href="#exclusions-title">Исключения</a>
        <a href="#docs-title">Документы</a>
        <a href="#how-title">Как оформить</a>
      </nav>
    </section>

    <div class="offer-layout">
      <div class="offer-body">
        <section class="offer-section" aria-labelledby="about-title">
          <h2 id="about-title">О продукте</h2>
          <p>{offer.description}</p>
        </section>

        <section class="offer-section" aria-labelledby="coverage-title">
          <h2 id="coverage-title">Что покрывает</h2>
          <ul class="bullet-list two-col-list">
            {offer.coverage.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        {offer.features && offer.features.length > 0 && (
          <section class="offer-section" aria-labelledby="features-title">
            <h2 id="features-title">Дополнительные особенности</h2>
            <p class="small muted" style="margin-bottom:12px">
              Сервис, оформление и другие свойства продукта. Эти пункты не означают, что указанный риск входит в страховое покрытие.
            </p>
            <ul class="bullet-list">
              {offer.features.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}

        {offer.conditions && (
          <ProductConditions conditions={offer.conditions} source={offer.source} checkedAt={offer.checkedAt} />
        )}

        <section class="offer-section" aria-labelledby="limits-title">
          <h2 id="limits-title">Лимиты и важные условия</h2>
          <ul class="bullet-list">
            {offer.limits.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="offer-section" aria-labelledby="exclusions-title">
          <h2 id="exclusions-title">Что важно учесть</h2>
          <ul class="bullet-list">
            {offer.exclusions.map((item) => <li>{item}</li>)}
          </ul>
          <p class="small muted" style="margin-top:12px">
            Это не полный перечень исключений: он определяется правилами страхования и договором.
            Перед оформлением запросите у страховщика актуальные правила и образец договора.
          </p>
        </section>

        <section class="offer-section" aria-labelledby="obligation-title">
          <h2 id="obligation-title">Обязательность</h2>
          <div class:list={['obligation', `obligation--${obligation.status}`]}>
            <Icon name={obligationIcon[obligation.status]} size={19} />
            <div>
              <strong>{obligation.label}</strong>
              <p>{obligation.text}</p>
              {obligation.condition && <p class="obligation__condition">{obligation.condition}</p>}
            </div>
          </div>
          <p class="small muted" style="margin-top:12px">
            Статус относится именно к этому продукту. В разделе «{category.navTitle}» могут быть
            и другие предложения — с иным статусом обязательности.
          </p>
        </section>

        <section class="offer-section" aria-labelledby="docs-title">
          <h2 id="docs-title">Что понадобится при оформлении</h2>
          <ul class="bullet-list">
            {offer.documents.map((item) => <li>{item}</li>)}
          </ul>
          <p class="small muted" style="margin-top:12px">
            Точный список документов подтверждает страховщик. Каталог не собирает и не хранит
            персональные данные, ИИН, документы и фотографии.
          </p>
        </section>

        <section class="offer-section" aria-labelledby="how-title">
          <h2 id="how-title">Как оформить</h2>
          <p>{offer.purchase.note}</p>
          <Steps steps={steps} columns={3} class="steps--spaced" />
        </section>

        <div class="source-box">
          <span>
            Источник:{' '}
            <a
              class="link-arrow"
              href={offer.source.url}
              target="_blank"
              rel="noopener noreferrer nofollow"
              aria-label={`${offer.source.label}; откроется на ${sourceHost} в новой вкладке`}
            >
              {offer.source.label}
              <Icon name="arrow-up-right" size={14} />
            </a>
          </span>
          <span>Дата проверки: <strong>{dateLabel}</strong></span>
        </div>

        <p class="tiny">
          Информация носит справочный характер и не является офертой. Окончательные условия
          определяет договор страхования со страховщиком. Каталог не является страховщиком,
          агентом или брокером.
        </p>

        {related.length > 0 && (
          <section class="offer-section" aria-labelledby="related-title" style="margin-top:8px">
            <h2 id="related-title">Другие предложения в разделе</h2>
            <div class="grid grid--3">
              {related.map((item) => <OfferCard offer={item} />)}
            </div>
          </section>
        )}
      </div>

      <aside class="offer-aside" aria-label="Оформление и сведения о продукте">
        <div class="offer-cta offer-cta--aside">
          <p class="offer-cta__price">{offer.price.text}</p>
          {offer.price.note && <p class="offer-cta__note">{offer.price.note}</p>}
          <Button
            href={offer.purchase.url}
            variant="primary"
            size="lg"
            block
            external
            iconRight="external"
            aria-label={`${offer.purchase.ctaLabel} — ${host} (откроется в новой вкладке)`}
          >
            {offer.purchase.ctaLabel}
          </Button>
          <p class="offer-cta__domain">
            <Icon name="info" size={14} />
            <span>{destinationLabel} <strong>{host}</strong></span>
          </p>
          <p class="tiny" style="margin-top:8px">{offer.purchase.label}</p>
        </div>

        <div class="offer-facts">
          <dl>
            <div>
              <dt>Страховщик</dt>
              <dd><a href={`/kompanii/${company.slug}/`} style="text-decoration:underline;text-underline-offset:2px">{company.name}</a></dd>
            </div>
            <div>
              <dt>Вид страхования</dt>
              <dd>{category.title}</dd>
            </div>
            <div>
              <dt>Аудитория</dt>
              <dd>{audienceLabel}</dd>
            </div>
            <div>
              <dt>Обязательность</dt>
              <dd>{obligation.label}</dd>
            </div>
            <div>
              <dt>Способ оформления</dt>
              <dd>{purchaseLabels[offer.purchase.method]}</dd>
            </div>
            <div>
              <dt>Проверено</dt>
              <dd>{dateLabel}</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>

  <div class="sticky-cta">
    <div class="sticky-cta__inner">
      <p class="sticky-cta__text">
        <strong>{offer.title}</strong>
        {offer.price.text} · {host}
      </p>
      <Button href={offer.purchase.url} variant="primary" external iconRight="external">
        {offer.purchase.ctaLabel}
      </Button>
    </div>
  </div>
</Base>
