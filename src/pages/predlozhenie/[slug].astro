---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CompanyMark from '../../components/CompanyMark.astro';
import OfferCard from '../../components/OfferCard.astro';
import { publishedOffers } from '../../data/products';
import { companyById } from '../../data/companies';
import { categoryById } from '../../data/categories';
import { purchaseLabels, obligationShort } from '../../data/types';
import { site } from '../../data/site';

export function getStaticPaths() {
  return publishedOffers.map((offer) => ({ params: { slug: offer.slug }, props: { offer } }));
}

const { offer } = Astro.props;
const company = companyById(offer.companyId);
const category = categoryById(offer.categoryId);
if (!company || !category) throw new Error(`Некорректные связи продукта ${offer.slug}`);

const basePath = offer.audience === 'individual' ? '/dlya-sebya' : '/dlya-biznesa';
const audienceLabel = offer.audience === 'individual' ? 'Для себя' : 'Для бизнеса';
const host = new URL(offer.purchase.url).host.replace(/^www\./, '');
const dateLabel = new Date(offer.checkedAt).toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const related = publishedOffers
  .filter((o) => o.categoryId === offer.categoryId && o.audience === offer.audience && o.slug !== offer.slug)
  .slice(0, 3);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: '/' },
      { '@type': 'ListItem', position: 2, name: audienceLabel, item: `${basePath}/` },
      { '@type': 'ListItem', position: 3, name: category.navTitle, item: `${basePath}/${category.slug}/` },
      { '@type': 'ListItem', position: 4, name: offer.title, item: `/predlozhenie/${offer.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${offer.title} — ${company.name}`,
    description: offer.tagline,
    inLanguage: 'ru-KZ',
    dateModified: offer.checkedAt,
    isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
  },
];
---

<Base
  title={`${offer.title} — ${company.name}`}
  description={`${offer.tagline} Покрытие, ограничения, способ оформления и официальная ссылка. Проверено ${dateLabel}.`}
  audience={offer.audience}
  schema={schema}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: 'Главная', href: '/' },
        { label: audienceLabel, href: `${basePath}/` },
        { label: category.navTitle, href: `${basePath}/${category.slug}/` },
        { label: offer.title },
      ]}
    />

    <header class="offer-header">
      <div class="offer-header__company">
        <a href={`/kompanii/${company.slug}/`} aria-label={`Страховщик ${company.name}`}>
          <CompanyMark companyId={company.id} size="md" />
        </a>
        <span class="chip chip--outline">{audienceLabel}</span>
        <a class="chip" href={`${basePath}/${category.slug}/`}>{category.navTitle}</a>
      </div>
      <h1>{offer.title}</h1>
      <p class="offer-header__tagline">{offer.tagline}</p>
      <div class="meta-row" style="margin-top:14px">
        <span class="chip chip--brand">{purchaseLabels[offer.purchase.method]}</span>
        <span class={`chip ${category.obligation.status === 'required' ? 'chip--warn' : ''}`}>
          {obligationShort[category.obligation.status]}
        </span>
        <span class="chip chip--outline">Проверено {dateLabel}</span>
      </div>
    </header>

    <div class="offer-layout">
      <div class="offer-body">
        <section class="offer-section" aria-labelledby="about-title">
          <h2 id="about-title">О продукте</h2>
          <p>{offer.description}</p>
        </section>

        <section class="offer-section" aria-labelledby="coverage-title">
          <h2 id="coverage-title">Что покрывает</h2>
          <ul class="bullet-list two-col-list">
            {offer.coverage.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="offer-section" aria-labelledby="limits-title">
          <h2 id="limits-title">Лимиты и важные условия</h2>
          <ul class="bullet-list">
            {offer.limits.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="offer-section" aria-labelledby="exclusions-title">
          <h2 id="exclusions-title">Что важно учесть</h2>
          <ul class="bullet-list">
            {offer.exclusions.map((item) => <li>{item}</li>)}
          </ul>
          <p class="small muted" style="margin-top:12px">
            Это не полный перечень исключений: он определяется правилами страхования и договором.
            Перед оформлением запросите у страховщика актуальные правила и образец договора.
          </p>
        </section>

        <section class="offer-section" aria-labelledby="obligation-title">
          <h2 id="obligation-title">Обязательность</h2>
          <div class="obligation">
            <Icon name="info" size={19} />
            <div>
              <strong>{category.obligation.label}</strong>
              {offer.obligationNote}
            </div>
          </div>
        </section>

        <section class="offer-section" aria-labelledby="docs-title">
          <h2 id="docs-title">Что понадобится при оформлении</h2>
          <ul class="bullet-list">
            {offer.documents.map((item) => <li>{item}</li>)}
          </ul>
          <p class="small muted" style="margin-top:12px">
            Точный список документов подтверждает страховщик. Каталог не собирает и не хранит
            персональные данные, ИИН, документы и фотографии.
          </p>
        </section>

        <section class="offer-section" aria-labelledby="how-title">
          <h2 id="how-title">Как оформить</h2>
          <p>{offer.purchase.note}</p>
          <div class="steps" style="margin-top:18px;grid-template-columns:repeat(3,minmax(0,1fr))">
            <div class="step">
              <span class="step__num">1</span>
              <h3>Перейдите на сайт</h3>
              <p>Кнопка ведёт на {host} — официальную страницу страховщика.</p>
            </div>
            <div class="step">
              <span class="step__num">2</span>
              <h3>Заполните данные</h3>
              <p>Данные для расчёта и договора вы вводите напрямую страховщику.</p>
            </div>
            <div class="step">
              <span class="step__num">3</span>
              <h3>Оплатите и получите полис</h3>
              <p>Оплата и выдача документа происходят у страховой компании.</p>
            </div>
          </div>
        </section>

        <div class="source-box">
          <span>
            Источник: <a class="link-arrow" href={offer.source.url} target="_blank" rel="noopener noreferrer nofollow">{offer.source.label} <Icon name="arrow-up-right" size={14} /></a>
          </span>
          <span>Дата проверки: <strong>{dateLabel}</strong></span>
        </div>

        <p class="tiny">
          Информация носит справочный характер и не является офертой. Окончательные условия
          определяет договор страхования со страховщиком. Каталог не является страховщиком,
          агентом или брокером.
        </p>

        {related.length > 0 && (
          <section class="offer-section" aria-labelledby="related-title" style="margin-top:8px">
            <h2 id="related-title">Другие предложения в разделе</h2>
            <div class="grid grid--3">
              {related.map((item) => <OfferCard offer={item} />)}
            </div>
          </section>
        )}
      </div>

      <aside class="offer-aside" aria-label="Оформление и сведения о продукте">
        <div class="offer-cta offer-cta--aside">
          <p class="offer-cta__price">{offer.price.text}</p>
          {offer.price.note && <p class="offer-cta__note">{offer.price.note}</p>}
          <a
            class="btn btn--primary btn--block btn--lg"
            href={offer.purchase.url}
            target="_blank"
            rel="noopener noreferrer nofollow"
          >
            {offer.purchase.ctaLabel}
            <Icon name="external" size={16} />
          </a>
          <p class="offer-cta__domain">
            <Icon name="info" size={14} />
            <span>Оформление и оплата — на сайте страховщика: <strong>{host}</strong></span>
          </p>
          <p class="tiny" style="margin-top:8px">{offer.purchase.label}</p>
        </div>

        <div class="offer-facts">
          <dl>
            <div>
              <dt>Страховщик</dt>
              <dd><a href={`/kompanii/${company.slug}/`} style="text-decoration:underline;text-underline-offset:2px">{company.name}</a></dd>
            </div>
            <div>
              <dt>Вид страхования</dt>
              <dd>{category.title}</dd>
            </div>
            <div>
              <dt>Аудитория</dt>
              <dd>{audienceLabel}</dd>
            </div>
            <div>
              <dt>Способ оформления</dt>
              <dd>{purchaseLabels[offer.purchase.method]}</dd>
            </div>
            <div>
              <dt>Проверено</dt>
              <dd>{dateLabel}</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>

  <div class="sticky-cta">
    <div class="sticky-cta__inner">
      <p class="sticky-cta__text">
        <strong>{offer.title}</strong>
        {offer.price.text} · {host}
      </p>
      <a
        class="btn btn--primary"
        href={offer.purchase.url}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >
        {offer.purchase.ctaLabel}
        <Icon name="external" size={15} />
      </a>
    </div>
  </div>
</Base>
