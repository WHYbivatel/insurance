---
import AudiencePage from '../../components/AudiencePage.astro';

const faq = [
  {
    q: 'Все перечисленные страховки обязательны для компании?',
    a: 'Нет. Обязательность зависит от вида деятельности и объектов. Например, ОГПО транспорта, страхование работников от НС, ответственность перевозчика и владельцев опасных объектов обязательны при определённых условиях. Имущество, грузы и ДМС — добровольные.',
  },
  {
    q: 'Можно ли застраховать только часть сотрудников?',
    a: 'По обязательному страхованию работников — нет, оно распространяется на работников по закону. По добровольным программам состав застрахованных определяется договором.',
  },
  {
    q: 'Почему условия приходится уточнять у страховщика?',
    a: 'Корпоративные программы часто собираются индивидуально: влияют объекты, оборот, история убытков и требования банка или контракта. Публичная страница даёт рамку, а точные условия — в договоре.',
  },
  {
    q: 'Куда ведёт кнопка оформления?',
    a: 'На официальный сайт страховщика — страницу продукта или форму заявки. Если онлайн-оформления нет, указано, что нужен менеджер или отделение.',
  },
];
---

<AudiencePage
  audience="business"
  title="Страхование для бизнеса"
  description="Каталог страхования для юридических лиц и предпринимателей Казахстана: работники, автопарк, имущество, грузы, строительство, ответственность и экологические риски."
  eyebrow="Юридическим лицам и ИП"
  heading="Страхование для бизнеса"
  lead="Восемь направлений: работники, транспорт, имущество, грузы, стройка, ответственность, экология и отраслевые программы. Объясняем, что обязательно именно для вашей деятельности, а что — добровольно."
  catalogTitle="Все предложения для бизнеса"
  catalogLead="Фильтруйте по компании, способу оформления и обязательности. Для корпоративных программ чаще нужна заявка и расчёт менеджера."
  crossLink={{ href: '/dlya-sebya/', label: 'Перейти в раздел для себя →' }}
  note="Обязанность страхования зависит от деятельности компании и требований закона. Каталог не заменяет юридическую консультацию: проверьте применимые нормы и условия договора со страховщиком."
  faq={faq}
  faqTitle="Вопросы бизнеса"
/>
