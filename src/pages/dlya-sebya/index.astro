---
import AudiencePage from '../../components/AudiencePage.astro';

const faq = [
  {
    q: 'С чего начать, если я не знаю, какая страховка нужна?',
    a: 'Начните с задачи: обязательная автогражданка, защита своего автомобиля, квартира, поездка или здоровье. В каждом разделе есть объяснение и примеры ситуаций.',
  },
  {
    q: 'Можно ли оформить полис здесь?',
    a: 'Нет. Каталог помогает выбрать и объясняет условия, а оформление происходит на сайте страховщика, по телефону или в отделении. Кнопка на карточке ведёт на официальный источник.',
  },
  {
    q: 'Почему в каталоге нет моего города или компании?',
    a: 'Каталог наполняется постепенно и только проверенными предложениями. Если продукт или компанию не удалось подтвердить по официальному источнику, мы не добавляем их.',
  },
  {
    q: 'Цены в каталоге окончательные?',
    a: 'Нет. Мы показываем цену только там, где она подтверждена, и всегда указываем, если стоимость рассчитывается индивидуально. Итоговую премию определяет страховщик по договору.',
  },
];
---

<AudiencePage
  audience="individual"
  title="Страхование для себя"
  description="Каталог страхования для физических лиц в Казахстане: ОГПО ВТС, КАСКО, квартира, здоровье, поездки и накопительные программы. Объяснения и проверенные предложения компаний."
  eyebrow="Частным лицам"
  heading="Страхование для себя"
  lead="Семь разделов о том, что и от чего защищает: автомобиль, квартира, здоровье, поездки и долгосрочные программы. В каждом — объяснение, отличия от похожих продуктов и предложения страховщиков с указанием источника."
  catalogTitle="Все предложения для частных лиц"
  catalogLead="Фильтруйте по компании, способу оформления и обязательности. Ссылки ведут на страницы продуктов у страховщиков."
  crossLink={{ href: '/dlya-biznesa/', label: 'Перейти в раздел для бизнеса →' }}
  note="Окончательные условия страхования определяет договор страховщика. Информация в каталоге носит справочный характер: перед оформлением проверьте покрытие, исключения, франшизу и порядок выплаты на сайте компании."
  faq={faq}
  faqTitle="Вопросы о выборе"
/>
