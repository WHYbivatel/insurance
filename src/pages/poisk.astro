---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/categories';
import { companies } from '../data/companies';
import { publishedOffers, companyName, categoryTitle } from '../data/products';

const items = [
  ...categories.map((c) => ({
    title: c.title,
    sub: c.audience === 'individual' ? 'Для себя' : 'Для бизнеса',
    url: c.audience === 'individual' ? `/dlya-sebya/${c.slug}/` : `/dlya-biznesa/${c.slug}/`,
    type: 'Раздел',
    text: `${c.short} ${c.lead}`,
  })),
  ...companies.map((c) => ({
    title: c.name,
    sub: `Страховщик · ${c.city}`,
    url: `/kompanii/${c.slug}/`,
    type: 'Компания',
    text: c.summary,
  })),
  ...publishedOffers.map((o) => ({
    title: o.title,
    sub: `${companyName(o.companyId)} · ${categoryTitle(o.categoryId)}`,
    url: `/predlozhenie/${o.slug}/`,
    type: 'Предложение',
    text: `${o.tagline} ${o.description} ${o.coverage.join(' ')}`,
  })),
];

const json = JSON.stringify(items).replace(/</g, '\\u003c');

const popular = [
  { label: 'ОГПО', href: '/poisk/?q=ОГПО' },
  { label: 'КАСКО', href: '/poisk/?q=КАСКО' },
  { label: 'Квартира', href: '/poisk/?q=квартира' },
  { label: 'ДМС', href: '/poisk/?q=ДМС' },
  { label: 'Грузы', href: '/poisk/?q=груз' },
];
---

<Base
  title="Поиск по каталогу"
  description="Поиск по видам страхования, страховым компаниям и предложениям каталога «Полис»."
  noindex={true}
>
  <div class="container container--narrow">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Поиск' }]} />

    <div class="page-head">
      <span class="eyebrow">Поиск</span>
      <h1 class="page-head__title page-head__title--wide">Найдите страховку, компанию или раздел</h1>
      <p class="page-head__lead">
        Введите запрос — например, «ОГПО», «квартира», «ДМС», «груз» или название компании.
      </p>
    </div>

    <form class="search search--page" action="/poisk/" method="get" role="search">
      <Icon name="search" size={19} class="search__icon" />
      <label class="sr-only" for="global-search">Поиск по каталогу</label>
      <input
        class="search__input"
        id="global-search"
        type="search"
        name="q"
        placeholder="Например: ОГПО или Евразия"
        autocomplete="off"
        data-global-input
      />
      <button class="search__submit" type="submit">Найти</button>
    </form>

    <p class="catalog__count search__counter" data-global-count aria-live="polite" hidden></p>

    <div class="search-hint" data-global-hint>
      <h2 class="search-hint__title">С чего начать</h2>
      <p class="small muted">Попробуйте один из частых запросов или откройте раздел каталога.</p>
      <div class="chip-row">
        {popular.map((item) => <a class="chip chip--brand" href={item.href}>{item.label}</a>)}
      </div>
    </div>

    <div data-global-results aria-live="polite"></div>

    <div data-global-empty hidden>
      <EmptyState
        title="Ничего не найдено"
        description="Попробуйте более короткий запрос или выберите раздел каталога вручную."
        actionLabel="Открыть каталог"
        href="/dlya-sebya/"
      />
    </div>

    <noscript>
      <EmptyState
        title="Для поиска нужен JavaScript"
        description="Каталог работает и без него: откройте раздел «Для себя» или «Для бизнеса» и выберите категорию."
        actionLabel="Перейти в каталог"
        href="/dlya-sebya/"
        icon="info"
      />
    </noscript>
  </div>

  <template data-row-arrow>
    <Icon name="arrow" size={18} />
  </template>

  <script type="application/json" id="global-index" set:html={json} />

  <script>
    import { initSearchPage } from '../lib/search-page';
    initSearchPage();
  </script>
</Base>
