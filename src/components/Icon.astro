---
/**
 * Icon — единая точка подключения иконок Lucide.
 *
 * Иконки берутся из @lucide/astro и рендерятся как inline SVG на этапе сборки:
 * на клиент не уходит ни байта JavaScript и не подключается вся библиотека.
 * Карта имён живёт в src/lib/icons.ts — там же меняется иконка.
 *
 * Лицензия Lucide — ISC, см. THIRD_PARTY_NOTICES.md и https://lucide.dev/license
 */
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Толщина линий. По умолчанию 1.75 — единая для всего интерфейса. */
  strokeWidth?: number;
  /** Если задано, иконка становится осмысленной для скринридера. */
  title?: string;
}

const { name, size = 20, class: className, strokeWidth = 1.75, title } = Astro.props;

const Component = icons[name];

if (!Component) {
  throw new Error(`Неизвестная иконка «${name}». Добавьте её в карту src/lib/icons.ts.`);
}

/* Декоративная иконка скрыта от скринридеров; осмысленная получает имя. */
const a11y = title
  ? ({ role: 'img', 'aria-label': title } as const)
  : ({ 'aria-hidden': 'true', focusable: 'false' } as const);
---

<Component
  size={size}
  stroke-width={strokeWidth}
  class={className}
  color="currentColor"
  {...a11y}
/>
