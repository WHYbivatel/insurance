---
/**
 * Header — шапка сайта.
 * Навигация и переключатель аудитории собраны из компонентов UI kit.
 */
import AudienceSwitch from './ui/AudienceSwitch.astro';
import IconButton from './ui/IconButton.astro';
import MobileMenu from './ui/MobileMenu.astro';
import type { Audience } from '../data/types';

interface Props {
  audience?: Audience;
}

const { audience } = Astro.props;

const links = [
  { href: '/dlya-sebya/', label: 'Для себя', key: 'individual' },
  { href: '/dlya-biznesa/', label: 'Для бизнеса', key: 'business' },
  { href: '/kompanii/', label: 'Компании', key: '' },
  { href: '/o-servise/', label: 'О сервисе', key: '' },
];

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href="/" aria-label="Полис — на главную">
      <span class="logo__mark">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 2.6l7.4 3.2v5.1c0 4.8-3.1 8.5-7.4 10.5-4.3-2-7.4-5.7-7.4-10.5V5.8L12 2.6z"
            fill="rgba(255,255,255,0.14)"
            stroke="#fff"
            stroke-width="1.5"></path>
          <path
            d="M8.6 12.1l2.3 2.3 4.6-4.6"
            stroke="#fff"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="logo__text">
        <span class="logo__name">Полис</span>
        <span class="logo__tag">страхование в Казахстане</span>
      </span>
    </a>

    <nav class="nav nav--desktop" aria-label="Основная навигация">
      {
        links.map((link) => (
          <a
            class="nav__link"
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            data-nav-audience={link.key || undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <AudienceSwitch audience={audience} class="header__switch" />
      <IconButton
        icon="menu"
        label="Открыть меню"
        class="menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      />
    </div>
  </div>

  <MobileMenu links={links} current={current} audience={audience} />
</header>
