---
/**
 * Faq — блок частых вопросов.
 * Раскрытие и доступность обеспечивает общий Accordion, здесь только
 * заголовок секции и отступы.
 */
import Accordion from './ui/Accordion.astro';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
  eyebrow?: string;
  idPrefix?: string;
}

const { items, title = 'Частые вопросы', eyebrow = 'FAQ', idPrefix = 'faq' } = Astro.props;
const titleId = `${idPrefix}-title`;
---

<section class="section section--tight" aria-labelledby={titleId}>
  <div class="section-head">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h2 id={titleId} style="margin-top:8px">{title}</h2>
    </div>
  </div>
  <Accordion items={items} idPrefix={idPrefix} />
</section>
