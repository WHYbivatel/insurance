---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './ui/Breadcrumbs.astro';
import Badge from './ui/Badge.astro';
import CategoryCard from './ui/CategoryCard.astro';
import EmptyState from './ui/EmptyState.astro';
import Reveal from './ui/Reveal.astro';
import Icon from './Icon.astro';
import CatalogBrowser from './CatalogBrowser.astro';
import Faq from './Faq.astro';
import { categoryById } from '../data/categories';
import { offersByCategory, audienceCount, publishedOffers } from '../data/products';
import { purchaseLabels, obligationTone, obligationShort } from '../data/types';
import type { Category, ObligationStatus } from '../data/types';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const audience = category.audience;
const offers = offersByCategory(audience, category.id);
const basePath = audience === 'individual' ? '/dlya-sebya' : '/dlya-biznesa';
const audienceLabel = audience === 'individual' ? 'Для себя' : 'Для бизнеса';
const related = category.related
  .map((id) => categoryById(id))
  .filter((c): c is Category => Boolean(c) && c!.audience === audience);

const methods = Array.from(new Set(offers.map((o) => purchaseLabels[o.purchase.method])));

/* Обязательность считается по предложениям раздела, а не по категории:
   в одном разделе спокойно живут обязательные и добровольные продукты. */
const statusCounts = offers.reduce<Record<string, number>>((acc, offer) => {
  acc[offer.obligation.status] = (acc[offer.obligation.status] ?? 0) + 1;
  return acc;
}, {});

const pluralOffers = (n: number): string => {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return 'предложение';
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return 'предложения';
  return 'предложений';
};

const statusSummary = (['required', 'conditional', 'voluntary'] as ObligationStatus[])
  .filter((status) => statusCounts[status])
  .map((status) => `${statusCounts[status]} ${obligationShort[status].toLowerCase()}`)
  .join(' · ');

const singleStatus =
  offers.length > 0 && Object.keys(statusCounts).length === 1
    ? (Object.keys(statusCounts)[0] as ObligationStatus)
    : null;

const statusesFor = (categoryId: string): ObligationStatus[] =>
  Array.from(
    new Set(
      publishedOffers.filter((o) => o.categoryId === categoryId).map((o) => o.obligation.status)
    )
  );

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: '/' },
      { '@type': 'ListItem', position: 2, name: audienceLabel, item: `${basePath}/` },
      { '@type': 'ListItem', position: 3, name: category.navTitle, item: `${basePath}/${category.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: category.title,
    description: category.short,
    inLanguage: 'ru-KZ',
  },
];
---

<Base title={category.title} description={category.short} audience={audience} schema={schema}>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: 'Главная', href: '/' },
        { label: audienceLabel, href: `${basePath}/` },
        { label: category.navTitle },
      ]}
    />

    <div class="cat-hero">
      <div>
        <span class={`cat-hero__icon tint-${category.tint}`}><Icon name={category.icon} size={26} /></span>
        <span class="eyebrow">{audienceLabel} · {category.groupTitle}</span>
        <h1 style="margin-top:12px">{category.title}</h1>
        <p class="page-head__lead">{category.lead}</p>
        <div class="meta-row" style="margin-top:18px">
          {singleStatus ? (
            <Badge tone={obligationTone[singleStatus]} size="lg" icon={singleStatus === 'required' ? 'warning' : singleStatus === 'voluntary' ? 'success' : 'info'}>
              {obligationShort[singleStatus]}
            </Badge>
          ) : (
            <Badge tone="neutral" size="lg" icon="info">Статус — у каждого продукта</Badge>
          )}
          <span class="chip">{offers.length} {pluralOffers(offers.length)}</span>
          {methods.slice(0, 2).map((method) => <span class="chip chip--outline">{method}</span>)}
        </div>
      </div>

      <aside class="fact-panel" aria-label="Коротко о разделе">
        <p class="fact-panel__title">Коротко</p>
        <div class="fact-list">
          <div class="fact-list__item">
            <Icon name="check" size={16} />
            <span><strong>Кому:</strong> {category.whoFor[0]}</span>
          </div>
          <div class="fact-list__item">
            <Icon name="info" size={16} />
            <span>
              <strong>Обязательность:</strong>
              {statusSummary ? ` по продуктам — ${statusSummary}` : ' уточняется по продукту'}
            </span>
          </div>
          <div class="fact-list__item">
            <Icon name="doc" size={16} />
            <span><strong>В каталоге:</strong> {offers.length} проверенных {pluralOffers(offers.length)}</span>
          </div>
          <div class="fact-list__item">
            <Icon name="external" size={16} />
            <span><strong>Оформление:</strong> у страховщика</span>
          </div>
        </div>
      </aside>
    </div>

    <div class="grid grid--2" style="margin-top:30px">
      <section class="info-block" aria-labelledby="who-title">
        <h2 id="who-title">Кому подходит</h2>
        <ul class="bullet-list">
          {category.whoFor.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="info-block" aria-labelledby="risks-title">
        <h2 id="risks-title">Основные риски</h2>
        <ul class="bullet-list">
          {category.risks.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>

    <section style="margin-top:16px" aria-labelledby="obligation-title">
      <div class="obligation">
        <Icon name="info" size={19} />
        <div>
          <strong id="obligation-title">Обязательность в разделе</strong>
          <p>{category.obligation.text}</p>
          <p class="obligation__condition">
            Это описание вида страхования в целом. Статус каждого предложения указан в его
            карточке: {statusSummary || 'в разделе пока нет подтверждённых предложений'}.
          </p>
        </div>
      </div>
    </section>

    <Reveal as="section" class="section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Разобраться</span>
          <h2 id="diff-title">Чем отличается от похожих продуктов</h2>
        </div>
      </div>
      <div class="diff-grid">
        {category.differences.map((item) => (
          <div class="diff-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </Reveal>

    <section class="section section--tight" aria-labelledby="offers-title" style="padding-top:0">
      <div class="section-head">
        <div>
          <span class="eyebrow">Предложения</span>
          <h2 id="offers-title">{offers.length} {pluralOffers(offers.length)} в разделе</h2>
          <p>Сравните покрытие, способ оформления и компанию. Каждая карточка ведёт на подробное описание и официальный источник.</p>
        </div>
      </div>

      {offers.length > 0 ? (
        <CatalogBrowser offers={offers} audience={audience} />
      ) : (
        <EmptyState
          title="Пока нет подтверждённых предложений"
          description="Мы не заполняем раздел выдуманными продуктами. Если для этого вида страхования не удалось подтвердить действующее предложение, он остаётся справочным."
          icon="info"
          actionLabel="Вернуться в каталог"
          href={`${basePath}/`}
        />
      )}
    </section>
  </div>

  <div class="container">
    <Faq items={category.faq} title="Вопросы по этому виду страхования" idPrefix={`faq-${category.slug}`} />
  </div>

  {related.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Смотрите также</span>
            <h2>Связанные разделы</h2>
          </div>
        </div>
        <div class="grid grid--3">
          {related.map((cat) => (
            <CategoryCard
              category={cat}
              count={publishedOffers.filter((o) => o.categoryId === cat.id).length}
              statuses={statusesFor(cat.id)}
              href={`${basePath}/${cat.slug}/`}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container">
      <div class="note">
        Информация в разделе объясняет вид страхования в целом. Условия конкретного продукта
        могут отличаться: проверяйте покрытие, исключения и лимиты в договоре страховщика.
        Всего в каталоге {audienceCount(audience)} {pluralOffers(audienceCount(audience))} для этой аудитории.
      </div>
    </div>
  </section>
</Base>
