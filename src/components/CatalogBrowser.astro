---
/**
 * CatalogBrowser — каталог с фильтрами.
 *
 * Разметка только описывает данные: у каждой карточки есть data-атрибуты
 * компании, способа оформления и обязательности именно этого предложения.
 * Логику фильтрации, счётчик, пустое состояние и адрес ведёт lib/catalog.ts.
 */
import OfferCard from './ui/OfferCard.astro';
import FilterPanel from './ui/FilterPanel.astro';
import EmptyState from './ui/EmptyState.astro';
import Icon from './Icon.astro';
import { companies } from '../data/companies';
import { categoryById } from '../data/categories';
import type { Audience, Offer } from '../data/types';

interface Props {
  offers: Offer[];
  audience: Audience;
}

const { offers } = Astro.props;

const plural = (n: number): string => {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return 'предложение';
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return 'предложения';
  return 'предложений';
};

const searchText = (offer: Offer): string =>
  [
    offer.title,
    offer.tagline,
    offer.description,
    companies.find((c) => c.id === offer.companyId)?.name ?? '',
    categoryById(offer.categoryId)?.title ?? '',
    ...offer.coverage,
  ]
    .join(' ')
    .toLowerCase();
---

<section class="catalog" data-catalog>
  <FilterPanel offers={offers} />

  <div class="catalog__main">
    <div class="catalog__toolbar">
      <p class="catalog__count" data-count aria-live="polite">
        Найдено <strong>{offers.length}</strong> {plural(offers.length)}
      </p>
      <button
        class="btn btn--secondary catalog__mobile-filter"
        type="button"
        data-filter-toggle
        aria-expanded="false"
        aria-controls="catalog-filters"
      >
        <Icon name="filter" size={17} />
        Фильтры
      </button>
    </div>

    <div class="search search--catalog">
      <Icon name="search" size={18} class="search__icon" />
      <label class="sr-only" for="catalog-search">Поиск по каталогу</label>
      <input
        class="search__input"
        id="catalog-search"
        type="search"
        placeholder="Поиск по названию, компании или покрытию"
        autocomplete="off"
        data-catalog-search
      />
    </div>

    <div class="results" data-results>
      {offers.map((offer) => (
        <div
          class="results__item"
          data-offer-card
          data-company={offer.companyId}
          data-method={offer.purchase.method}
          data-obligation={offer.obligation.status}
          data-text={searchText(offer)}
        >
          <OfferCard offer={offer} />
        </div>
      ))}

      <EmptyState
        title="Ничего не найдено"
        description="Попробуйте изменить запрос или сбросить фильтры — в каталоге могут быть предложения с другим способом оформления."
        actionLabel="Сбросить фильтры"
        actionAttrs={{ 'data-reset': '', type: 'button' }}
        hidden
      />
    </div>
  </div>
</section>
