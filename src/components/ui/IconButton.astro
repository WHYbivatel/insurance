---
/**
 * IconButton — кнопка только с иконкой.
 * Доступное имя обязательно: передаётся через label и уходит в aria-label.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  icon: IconName;
  label: string;
  size?: 'sm' | 'md';
  plain?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const { icon, label, size = 'md', plain = false, type = 'button', class: className, ...rest } =
  Astro.props;

const classes = [
  'icon-btn',
  size === 'sm' ? 'icon-btn--sm' : '',
  plain ? 'icon-btn--plain' : '',
  className ?? '',
]
  .filter(Boolean)
  .join(' ');
---

<button class={classes} type={type} aria-label={label} title={label} {...rest}>
  <Icon name={icon} size={size === 'sm' ? 16 : 20} />
</button>
