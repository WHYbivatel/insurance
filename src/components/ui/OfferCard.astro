---
/**
 * OfferCard — карточка предложения.
 *
 * Показывает официальный логотип страховщика, обязательность именно этого
 * продукта (а не категории), способ оформления и цену, если она подтверждена.
 */
import Icon from '../Icon.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
import CompanyLogo from './CompanyLogo.astro';
import { companyById } from '../../data/companies';
import { categoryTitle } from '../../data/products';
import { externalHost } from '../../lib/external-link';
import {
  purchaseShort,
  purchaseLabels,
  obligationTone,
  type Offer,
} from '../../data/types';

interface Props {
  offer: Offer;
  audienceLabel?: string;
}

const { offer, audienceLabel } = Astro.props;

const company = companyById(offer.companyId);
if (!company) throw new Error(`Неизвестная компания: ${offer.companyId}`);

const priceShort =
  offer.price.kind === 'individual'
    ? 'Индивидуально'
    : offer.price.kind === 'calculated'
      ? 'Расчёт у страховщика'
      : offer.price.text;

const shortCta =
  offer.purchase.method === 'online'
    ? 'Оформить'
    : offer.purchase.method === 'partner'
      ? 'Перейти'
      : offer.purchase.method === 'request'
        ? 'Заявка'
        : 'Связаться';

const host = externalHost(offer.purchase.url);
const keyCoverage = offer.coverage[0];
const structured = offer.conditions;
const keyCondition = structured
  ? ('kasko' in structured
      ? structured.kasko.amountLimit.status === 'known'
        ? { label: 'Лимит', condition: structured.kasko.amountLimit }
        : structured.kasko.deductible.status === 'known'
          ? { label: 'Франшиза', condition: structured.kasko.deductible }
          : undefined
      : structured.travel.medicalLimit.status === 'known'
        ? { label: 'Медицинский лимит', condition: structured.travel.medicalLimit }
        : structured.travel.ageLimit.status === 'known'
          ? { label: 'Возраст', condition: structured.travel.ageLimit }
          : undefined)
  : undefined;
const keyConditionText = keyCondition
  ? `${typeof keyCondition.condition.value === 'number' ? keyCondition.condition.value.toLocaleString('ru-RU') : String(keyCondition.condition.value)}${keyCondition.condition.unit ? ` ${keyCondition.condition.unit}` : ''}`
  : undefined;
---

<article class="card card--hover offer-card">
  <div class="offer-card__head">
    <CompanyLogo company={company} variant="compact" showName={true} />
    {offer.badge && <Badge tone="brand">{offer.badge}</Badge>}
  </div>

  <h3 class="offer-card__title">
    <a href={`/predlozhenie/${offer.slug}/`}>{offer.title}</a>
  </h3>
  <p class="offer-card__desc">{offer.tagline}</p>

  <div class="offer-card__key-terms">
    <div class="offer-card__key-coverage">
      <Icon name="shield-check" size={16} />
      <span><strong>Покрытие:</strong> {keyCoverage}</span>
    </div>
    {keyCondition && keyConditionText && (
      <div class="offer-card__key-condition">
        <span>{keyCondition.label}</span>
        <strong>{keyConditionText}</strong>
      </div>
    )}
  </div>

  <div class="chip-row">
    <span class="chip">{categoryTitle(offer.categoryId)}</span>
    <Badge tone={obligationTone[offer.obligation.status]}>{offer.obligation.label}</Badge>
    {audienceLabel && <span class="chip chip--outline">{audienceLabel}</span>}
  </div>

  <dl class="offer-card__facts">
    <div class="offer-card__fact">
      <dt>Оформление</dt>
      <dd>{purchaseLabels[offer.purchase.method]}</dd>
    </div>
    <div class="offer-card__fact">
      <dt>Цена</dt>
      <dd>{priceShort}</dd>
    </div>
  </dl>
  {offer.price.note && <p class="offer-card__price-note">{offer.price.note}</p>}

  <div class="offer-card__actions">
    <Button href={`/predlozhenie/${offer.slug}/`} variant="ghost">Подробнее</Button>
    <Button
      href={offer.purchase.url}
      variant="primary"
      external
      aria-label={`${offer.purchase.ctaLabel} — ${host} (откроется в новой вкладке)`}
    >
      {shortCta}
      <Icon name="external" size={14} class="icon-external" />
    </Button>
  </div>
  <p class="tiny offer-card__note">
    Переход на {host} · {purchaseShort[offer.purchase.method].toLowerCase()}
  </p>
</article>
