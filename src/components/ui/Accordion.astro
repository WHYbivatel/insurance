---
/**
 * Accordion — раскрывающиеся блоки (FAQ).
 * Панель анимируется через grid-template-rows, кнопка управляет aria-expanded.
 */
import Icon from '../Icon.astro';

interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
  idPrefix?: string;
  /** Сколько блоков раскрыто изначально (0 — все закрыты). */
  openFirst?: number;
}

const { items, idPrefix = 'acc', openFirst = 0 } = Astro.props;
---

<div class="accordion">
  {
    items.map((item, index) => {
      const triggerId = `${idPrefix}-trigger-${index}`;
      const panelId = `${idPrefix}-panel-${index}`;
      const open = index < openFirst;
      return (
        <div class="accordion__item">
          <h3 style="margin:0">
            <button
              class="accordion__trigger"
              type="button"
              id={triggerId}
              aria-expanded={open ? 'true' : 'false'}
              aria-controls={panelId}
              data-accordion-trigger
            >
              <span>{item.q}</span>
              <Icon name="chevron-down" size={18} class="accordion__chevron" />
            </button>
          </h3>
          <div
            class="accordion__panel"
            id={panelId}
            role="region"
            aria-labelledby={triggerId}
            data-open={open ? 'true' : 'false'}
            inert={!open ? true : undefined}
          >
            <div>
              <div class="accordion__content">{item.a}</div>
            </div>
          </div>
        </div>
      );
    })
  }
</div>
