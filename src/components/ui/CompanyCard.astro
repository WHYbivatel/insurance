---
/**
 * CompanyCard — карточка страховщика в списках и результатах поиска.
 * Логотип официальный, название читаемое рядом, пропорции не искажаются.
 */
import CompanyLogo from './CompanyLogo.astro';
import type { Company } from '../../data/types';

interface Props {
  company: Company;
  count?: number;
  href?: string;
}

const { company, count, href = `/kompanii/${company.slug}/` } = Astro.props;

const plural = (n: number): string => {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return 'предложение';
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return 'предложения';
  return 'предложений';
};
---

<a class="card card--hover company-card" href={href}>
  <CompanyLogo company={company} variant="default" />
  <span class="company-card__name">{company.name}</span>
  <span class="company-card__summary">{company.summary}</span>
  <span class="cat-card__meta company-card__meta">
    <span>{company.city}</span>
    {typeof count === 'number' && <strong>{count} {plural(count)}</strong>}
  </span>
</a>
